{
  "name": "order-of-order-leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute order-of-order --remote --config wrangler.toml --file=./schema.sql",
    "db:init:local": "wrangler d1 execute order-of-order --local --config wrangler.toml --file=./schema.sql",
    "db:migrate:medal": "wrangler d1 execute order-of-order --remote --config wrangler.toml --file=./migrations/0001_medal.sql",
    "db:migrate:daily": "wrangler d1 execute order-of-order --remote --config wrangler.toml --file=./migrations/0002_daily.sql",
    "db:migrate:daily:local": "wrangler d1 execute order-of-order --local --config wrangler.toml --file=./migrations/0002_daily.sql",
    "board:reset": "node scripts/reset-board.mjs",
    "db:migrate:errors": "wrangler d1 execute order-of-order --remote --config wrangler.toml --file=./migrations/0003_errors.sql",
    "player:delete": "node scripts/delete-player.mjs",
    "errors": "wrangler d1 execute order-of-order --remote --config wrangler.toml --command \"SELECT datetime(last_seen/1000,'unixepoch') AS last_seen, count, version, platform, scene, substr(message,1,120) AS message FROM errors ORDER BY last_seen DESC LIMIT 50\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.30.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
