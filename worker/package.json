{
  "name": "order-of-order-leaderboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute order-of-order --remote --config wrangler.toml --file=./schema.sql",
    "db:init:local": "wrangler d1 execute order-of-order --local --config wrangler.toml --file=./schema.sql",
    "board:reset": "node scripts/reset-board.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.30.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
