# Build settings for the itch.io builds only, loaded by `--mode itch`
# (`npm run package:itch`, `npm run dev:itch`). Committed on purpose: these are
# build flags, not secrets. Secrets still come from `.env`, which Vite loads in
# every mode alongside this file.

# Gold frame around the outside of the game. On for itch.io, where the game
# sits inside the page's embed and wants a visible edge; off everywhere else.
VITE_GOLD_BORDER=true
