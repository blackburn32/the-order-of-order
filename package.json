{
  "name": "the-order-of-order",
  "private": true,
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:itch": "vite --mode itch",
    "dev:phone": "vite --mode phone",
    "build": "tsc --noEmit && vite build",
    "build:itch": "tsc --noEmit && vite build --mode itch",
    "build:phone": "tsc --noEmit && vite build --mode phone",
    "package:itch": "npm run build:itch && node scripts/package-itch.mjs",
    "phone": "npm run build:phone && npx cap copy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "sim": "tsx src/sim/runBatch.ts",
    "balance": "tsx src/sim/runBatch.ts",
    "items:check": "tsx src/sim/itemCheck.ts",
    "trials:check": "tsx src/sim/trialEndCheck.ts",
    "gold:check": "tsx src/sim/goldCheck.ts",
    "scoring:check": "tsx src/sim/compareScoring.ts",
    "curse:check": "tsx src/sim/curseCheck.ts",
    "curve:smart": "tsx src/sim/smartSurvivalCurve.ts",
    "pacing:feasibility": "tsx src/sim/pacingFeasibility.ts",
    "economy:experiment": "tsx src/sim/economyExperiment.ts",
    "duration:experiment": "tsx src/sim/durationExperiment.ts",
    "persistence:check": "tsx src/sim/activeRunPersistenceCheck.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.0"
  }
}
